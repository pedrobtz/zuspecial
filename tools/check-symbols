#!/bin/sh
# Fail when compiled objects import symbols CRAN's compiled-code check
# rejects, or when a shim object holds mutable state.
#
# Usage: tools/check-symbols [<dir>]   (default src; run after R CMD INSTALL,
# which leaves the *.o files there)
#
# 1. No object may import stdio output, process termination, assert or the
#    C library RNG (CLAUDE.md, Vendored native code).
# 2. No src/zsp_shim*.o may define writable data: the error mask in
#    zsp_error.o is the only mutable state (design section 8). zsp_boost.o
#    is not checked: Boost.Math keeps function-local statics that are
#    constant in effect (the `function` name pointers for its messages, and
#    constants such as get_min_shift_value computed once under a C++11
#    thread-safe guard), which this test cannot tell from real state.
set -eu

dir=${1:-src}
NM=${NM:-nm}
status=0

# The entry points R's own compiled-code check flags, plus the fortified
# (_chk) and mingw-w64 spellings the same calls compile to.
forbidden='^_?(v?f?printf|v?sprintf|__v?f?printf_chk|__v?sprintf_chk|puts|putchar|fputs|fputc|fwrite|f?flush|stdout|stderr|_?_?std(out|err)p?|__acrt_iob_func|__mingw_v?[fs]?printf|__ms_v?[fs]?printf|abort|exit|_exit|_Exit|__assert_fail|__assert_rtn|_assert|_wassert|rand|rand_r|srand|srand48|random|srandom|_ZSt4cout|_ZSt4cerr|_ZNSt3__14coutE|_ZNSt3__14cerrE)$'

command -v "${NM%% *}" >/dev/null 2>&1 || { echo "nm not found: $NM" >&2; exit 2; }

set -- "$dir"/*.o
[ -e "$1" ] || { echo "no objects in $dir; build first" >&2; exit 2; }

for obj in "$@"; do
  # Capture first, so set -e stops on an nm failure instead of passing.
  undef=$($NM -u "$obj")
  bad=$(printf '%s\n' "$undef" | awk '{print $NF}' | grep -E "$forbidden" || true)
  if [ -n "$bad" ]; then
    echo "$obj imports:" $bad >&2
    status=1
  fi
done

for obj in "$dir"/zsp_shim*.o; do
  [ -e "$obj" ] || continue
  # u, V and v: GNU unique and weak objects, which GCC uses for statics in
  # inline functions and for inline variables. The sysv format adds each
  # symbol's section where the object format has one (ELF), so tables that
  # are read-only once relocated (.data.rel.ro, as GCC places constexpr
  # arrays of pointers under -fPIC) and .rodata are not counted as state.
  syms=$($NM --format=sysv "$obj" 2>/dev/null) || syms=
  if [ -n "$syms" ]; then
    state=$(printf '%s\n' "$syms" | awk -F'|' 'NF >= 7 {
      name = $1; class = $3; section = $7
      gsub(/ /, "", name); gsub(/ /, "", class); gsub(/ /, "", section)
      if (class ~ /^[BbDduVv]$/ && section !~ /^\.(data\.rel\.ro|rodata)/)
        print name
    }')
  else
    syms=$($NM "$obj")
    state=$(printf '%s\n' "$syms" | awk '$2 ~ /^[BbDduVv]$/ {print $3}')
  fi
  # Not state either: section symbols (.bss, .data), which mingw's nm lists
  # even when empty, and GCC's DW.ref.__gxx_personality_v0, the exception
  # personality pointer every C++ object with unwind tables carries.
  state=$(printf '%s\n' "$state" |
    grep -Ev '^(\.|DW\.ref\.__gxx_personality_v0$)' | grep -v '^$' || true)
  if [ -n "$state" ]; then
    echo "$obj defines mutable data:" $state >&2
    status=1
  fi
done

[ "$status" -eq 0 ] && echo "symbols ok: $# objects in $dir"
exit "$status"
